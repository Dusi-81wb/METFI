# Backend Configuration
PROJECT_NAME="METFI Autonomous Finance Controller"
ENVIRONMENT="development"
DEBUG=true
VERSION="0.1.0"

# Server
HOST="0.0.0.0"
PORT=8000
API_V1_STR="/api/v1"

# CORS
BACKEND_CORS_ORIGINS=["http://localhost:3000", "http://127.0.0.1:3000"]

# Database
DATABASE_URL="postgresql+asyncpg://metfi_admin:metfi_secure_password@localhost:5432/metfi_reconciliation"

# AI Provider
AI_PROVIDER="gemini"
GEMINI_API_KEY=""
OPENAI_API_KEY=""
DEFAULT_AI_MODEL="gemini-2.5-pro"
