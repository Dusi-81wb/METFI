# Backend Configuration
PROJECT_NAME="METFI Autonomous Finance Controller"
ENVIRONMENT="development"
DEBUG=true
VERSION="0.1.0"

# Server
HOST="0.0.0.0"
PORT=8000
API_V1_STR="/api/v1"

# CORS
BACKEND_CORS_ORIGINS=["http://localhost:3000", "http://127.0.0.1:3000", "http://frontend:3000"]

# Database
DATABASE_URL="postgresql+asyncpg://metfi_admin:CHANGE_ME_IN_PRODUCTION@localhost:5432/metfi_reconciliation"

# AI Provider
AI_PROVIDER="mock"
GEMINI_API_KEY="your_gemini_api_key_here"
OPENAI_API_KEY="your_openai_api_key_here"
DEFAULT_AI_MODEL="gemini-2.5-pro"
